# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWT tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me

# Local default is SQLite. In production, set your Postgres URL in the
# hosting dashboard (Render environment variables), not in a file.
DATABASE_URL=sqlite:///./app.db

# Browser origin allowed by CORS (for example your deployed frontend).
# "*" allows every origin.
FRONTEND_ORIGIN=*
